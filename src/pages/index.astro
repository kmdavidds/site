---
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components'
import profilePicture from '../assets/profile-picture.png'
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="text-evening">
		<main class="bg-midnight min-h-dvh min-w-screen flex flex-col">
            <section class="flex flex-col min-h-dvh justify-center items-center">
                <Image src={profilePicture} alt="A photo of Komang David" class="w-32 rounded-full mb-8" style="box-shadow: 0 0 160px rgba(255, 255, 255, 0.3);" />
			    <h1 class="text-white text-3xl font-bold mb-4">Komang David</h1>
                <div class="w-16 h-px mb-4" style="background: linear-gradient(to right, transparent, rgba(255, 255, 255, 0.15), transparent);"></div>
                <h2 class="text-xl mb-8">Software Engineer</h2>
                <p class="max-w-lg text-center mb-16 mx-4">Building reliable software with Go, Typescript, and Python. Previously at XLSMART.</p>
                <div class="flex gap-8">
                    <a href="https://linkedin.com/in/komangdavid" target="_blank" rel="noopener noreferrer" class="bg-night p-2 scale-150 rounded-lg transition-all duration-300 hover:brightness-200" title="LinkedIn">
                        <Icon name="simple-icons:linkedin"/>
                    </a>
                    <a href="https://github.com/kmdavidds" target="_blank" rel="noopener noreferrer" class="bg-night p-2 scale-150 rounded-lg transition-all duration-300 hover:brightness-200" title="GitHub">
                        <Icon name="simple-icons:github"/>
                    </a>
                    <a href="mailto:kmdavidds@gmail.com" class="bg-night p-2 scale-150 rounded-lg transition-all duration-300 hover:brightness-200" title="Email">
                        <Icon name="simple-icons:gmail"/>
                    </a>
                    <button type="button" id="resume-button" class="bg-night p-2 scale-150 rounded-lg transition-all duration-300 hover:brightness-200" title="Resume" aria-label="Open resume">
                        <Icon name="lucide:file-text" />
                    </button>
                </div>
            </section>
            <dialog id="resume-dialog" class="m-auto h-[calc(100dvh-1rem)] w-[calc(100%-1rem)] max-w-none overflow-hidden rounded-lg bg-night p-0 text-white shadow-2xl backdrop:bg-black/70 md:h-[90dvh] md:w-[min(1000px,calc(100%-2rem))]">
                <div class="flex h-full min-h-0 flex-col">
                    <div class="flex shrink-0 items-center justify-between gap-4 border-b border-white/10 px-3 py-3 sm:px-4">
                        <h2 class="text-sm font-medium">Resume</h2>
                        <div class="flex items-center gap-3 sm:gap-4">
                            <a href="/Komang David Dananjaya Suartana - Resume.pdf" target="_blank" rel="noopener noreferrer" class="p-1 opacity-70 transition-opacity hover:opacity-100" title="Open resume in new tab" aria-label="Open resume in new tab">
                                <Icon name="lucide:external-link" size="16" />
                            </a>
                            <button type="button" id="resume-close" class="p-1 text-xl leading-none opacity-70 transition-opacity hover:opacity-100" aria-label="Close resume">&times;</button>
                        </div>
                    </div>
                    <iframe src="/Komang David Dananjaya Suartana - Resume.pdf" title="Komang David's resume" class="block min-h-0 w-full flex-1 border-0"></iframe>
                </div>
            </dialog>
            <script>
                const resumeButton = document.querySelector<HTMLButtonElement>('#resume-button');
                const resumeDialog = document.querySelector<HTMLDialogElement>('#resume-dialog');
                const resumeClose = document.querySelector<HTMLButtonElement>('#resume-close');

                resumeButton?.addEventListener('click', () => resumeDialog?.showModal());
                resumeClose?.addEventListener('click', () => resumeDialog?.close());
                resumeDialog?.addEventListener('click', (event) => {
                    if (event.target === resumeDialog) resumeDialog.close();
                });
            </script>
		</main>
	</body>
</html>
